<Window x:Class="Nodilume.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Nodilume — Le mie mappe" Width="1280" Height="820"
 MinWidth="860" MinHeight="600" Background="#0A111B" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#152536" Padding="12,8">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="2*"/>
     <ColumnDefinition Width="2*"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mappa" Foreground="#D6E7F5"
      VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="MapPicker" MinWidth="160"
      Margin="0,0,12,0" SelectionChanged="MapPicker_SelectionChanged"
      AutomationProperties.Name="Mappa attiva"/>
    <TextBox Grid.Row="0" Grid.Column="2" x:Name="MapNameInput" MaxLength="120"
      Margin="0,0,12,0" VerticalContentAlignment="Center"
      ToolTip="Nome per nuova mappa o rinomina"/>
    <Button Grid.Row="0" Grid.Column="3" x:Name="NewMapButton" Content="Nuova mappa"
      Padding="12,5" Margin="0,0,8,0" Click="NewMapButton_Click"/>
    <Button Grid.Row="0" Grid.Column="4" x:Name="RenameMapButton" Content="Rinomina"
      Padding="12,5" Click="RenameMapButton_Click"/>
    <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
      HorizontalAlignment="Right" Margin="0,8,0,0">
     <Button x:Name="ImportObsidianButton" Content="Importa vault Obsidian" Padding="12,5"
       Margin="0,0,8,0" Click="ImportObsidianButton_Click"/>
     <Button x:Name="ImportMapButton" Content="Importa file" Padding="12,5"
       Margin="0,0,8,0" Click="ImportMapButton_Click"/>
     <Button x:Name="ExportMapButton" Content="Esporta file" Padding="12,5"
       Margin="0,0,8,0" Click="ExportMapButton_Click"/>
     <Button x:Name="BackupMapButton" Content="Crea backup" Padding="12,5"
       Margin="0,0,8,0" Click="BackupMapButton_Click"/>
     <Button x:Name="RestoreBackupButton" Content="Ripristina backup" Padding="12,5"
       Click="RestoreBackupButton_Click"/>
    </WrapPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#101C29" Padding="16,7">
   <StackPanel Orientation="Horizontal">
    <TextBlock x:Name="MapStatus" Foreground="#90D8D0" FontSize="12" Margin="0,0,20,0"
      Text="Catalogo in caricamento…"/>
    <TextBlock x:Name="Status" Foreground="#B6C7D7" Text="Avvio della vista…" FontSize="12" />
   </StackPanel>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="310"/>
   </Grid.ColumnDefinitions>
   <wv:WebView2 Grid.Column="0" x:Name="Viewer" DefaultBackgroundColor="#0A111B" />
   <Border Grid.Column="1" Background="#142331" Padding="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="CERCA IDEE" Foreground="#DCEBF8" FontWeight="Bold"
        FontSize="14" Margin="0,0,0,8"/>
      <TextBox x:Name="SearchInput" MaxLength="160" Margin="0,0,0,6"
        KeyDown="SearchInput_KeyDown" TextChanged="SearchInput_TextChanged"
        AutomationProperties.Name="Prefisso titolo idea"/>
      <WrapPanel Margin="0,0,0,6">
       <Button x:Name="SearchButton" Content="Cerca" Click="SearchButton_Click"
         Padding="8,5" Margin="0,0,6,5"/>
       <Button x:Name="SearchNextButton" Content="Altri risultati"
         Click="SearchNextButton_Click" Padding="8,5" Margin="0,0,6,5"/>
       <Button x:Name="OpenSearchResultButton" Content="Apri"
         Click="OpenSearchResultButton_Click" Padding="8,5" Margin="0,0,0,5"/>
      </WrapPanel>
      <ListBox x:Name="SearchResultPicker" Height="126" Margin="0,0,0,6"
        SelectionChanged="SearchResultPicker_SelectionChanged"
        AutomationProperties.Name="Risultati ricerca">
       <ListBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="SearchPreviewText" MaxHeight="72" TextWrapping="Wrap"
        Foreground="#DCEBF8" Margin="0,0,0,5"/>
      <TextBlock x:Name="SearchStatus" TextWrapping="Wrap" FontSize="11"
        Foreground="#9FB6C8" Margin="0,0,0,10"/>
      <Separator Margin="0,0,0,12" Background="#3C566B"/>
      <TextBlock Text="EDITOR IDEE" Foreground="#DCEBF8" FontWeight="Bold"
        FontSize="14" Margin="0,0,0,8"/>
      <TextBlock x:Name="EditorSelectionText" Text="Nessuna idea selezionata"
        TextWrapping="Wrap" Foreground="#AAD6CE" Margin="0,0,0,10"/>
      <TextBlock Text="Titolo idea" Foreground="#DCEBF8"/>
      <TextBox x:Name="IdeaTitleInput" MaxLength="160" Margin="0,4,0,9"
        AutomationProperties.Name="Titolo idea"/>
      <TextBlock Text="Contenuto condiviso" Foreground="#DCEBF8"/>
      <TextBox x:Name="IdeaContentInput" MaxLength="200000" Height="108"
        AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
        Margin="0,4,0,8" AutomationProperties.Name="Contenuto idea"/>
      <WrapPanel Margin="0,0,0,12">
       <Button x:Name="CreateRootIdeaButton" Content="Nuova radice" Click="CreateRootIdeaButton_Click"
         Padding="8,5" Margin="0,0,6,5"/>
       <Button x:Name="CreateChildIdeaButton" Content="Nuova figlia" Click="CreateChildIdeaButton_Click"
         Padding="8,5" Margin="0,0,6,5"/>
       <Button x:Name="SaveIdeaButton" Content="Salva idea" Click="SaveIdeaButton_Click"
         Padding="8,5" Margin="0,0,6,5"/>
      </WrapPanel>
      <TextBlock Text="Annotazione della rappresentazione selezionata"
        TextWrapping="Wrap" Foreground="#DCEBF8"/>
      <TextBox x:Name="PlacementAnnotationInput" MaxLength="4000" Height="64"
        AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
        Margin="0,4,0,8" AutomationProperties.Name="Annotazione locale"/>
      <Button x:Name="SaveAnnotationButton" Content="Salva annotazione locale"
        Click="SaveAnnotationButton_Click" Padding="8,5" Margin="0,0,0,8"/>
      <Button x:Name="CreateRepresentationButton" Content="Aggiungi rappresentazione qui"
        Click="CreateRepresentationButton_Click" Padding="8,5" Margin="0,0,0,8"
        ToolTip="Aggiunge un altro nodo della stessa idea nel contesto corrente"/>
      <TextBlock Text="Seleziona un nodo nella scena per modificarlo. Una nuova figlia usa il nodo selezionato come genitore. La rappresentazione aggiuntiva usa il contesto corrente."
        TextWrapping="Wrap" FontSize="11" Foreground="#9FB6C8" Margin="0,4,0,12"/>
      <TextBlock x:Name="EditorStatus" Foreground="#AAD6CE" TextWrapping="Wrap"/>
      <Separator Margin="0,15,0,12" Background="#3C566B"/>
      <TextBlock Text="EDITOR RELAZIONI" Foreground="#DCEBF8" FontWeight="Bold"
        FontSize="14" Margin="0,0,0,8"/>
      <TextBlock Text="Scegli prima un nodo nella scena, premi Origine, poi scegli l'altro nodo e premi Destinazione."
        Foreground="#9FB6C8" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
      <TextBlock x:Name="RelationSourceText" Text="Origine: non scelta"
        Foreground="#DCEBF8" TextWrapping="Wrap"/>
      <Button x:Name="SetRelationSourceButton" Content="Origine = nodo selezionato"
        Click="SetRelationSourceButton_Click" Padding="8,5" Margin="0,4,0,8"/>
      <TextBlock x:Name="RelationTargetText" Text="Destinazione: non scelta"
        Foreground="#DCEBF8" TextWrapping="Wrap"/>
      <Button x:Name="SetRelationTargetButton" Content="Destinazione = nodo selezionato"
        Click="SetRelationTargetButton_Click" Padding="8,5" Margin="0,4,0,6"/>
      <Button x:Name="SwapRelationEndpointsButton" Content="Scambia origine e destinazione"
        Click="SwapRelationEndpointsButton_Click" Padding="8,5" Margin="0,0,0,10"/>
      <TextBlock Text="Relazioni dell'idea selezionata" Foreground="#DCEBF8"/>
      <ComboBox x:Name="RelationPicker" Margin="0,4,0,6" MinHeight="26"
        SelectionChanged="RelationPicker_SelectionChanged"
        AutomationProperties.Name="Relazione da modificare"/>
      <TextBlock x:Name="RelationListStatus" Foreground="#9FB6C8"
        FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="Tipo di relazione" Foreground="#DCEBF8"/>
      <TextBox x:Name="RelationKindInput" MaxLength="80" Margin="0,4,0,8"
        AutomationProperties.Name="Tipo relazione"/>
      <CheckBox x:Name="RelationDirectedCheck" Content="Relazione direzionale"
        IsChecked="True" Foreground="#DCEBF8" Margin="0,0,0,8"/>
      <TextBlock Text="Spiegazione" Foreground="#DCEBF8"/>
      <TextBox x:Name="RelationExplanationInput" MaxLength="4000" Height="74"
        AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
        Margin="0,4,0,9" AutomationProperties.Name="Spiegazione relazione"/>
      <WrapPanel Margin="0,0,0,8">
       <Button x:Name="CreateRelationButton" Content="Crea relazione"
         Click="CreateRelationButton_Click" Padding="8,5" Margin="0,0,6,5"/>
       <Button x:Name="SaveRelationButton" Content="Salva relazione"
         Click="SaveRelationButton_Click" Padding="8,5" Margin="0,0,6,5"/>
       <Button x:Name="DeleteRelationButton" Content="Elimina relazione"
         Click="DeleteRelationButton_Click" Padding="8,5" Margin="0,0,0,5"/>
      </WrapPanel>
      <TextBlock x:Name="RelationStatus" Foreground="#AAD6CE"
        TextWrapping="Wrap" Margin="0,0,0,10"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</Window>
